# Copy to .env and fill in. Never commit .env.

# --- LLM (Google Gemini via langchain-google-genai; any OpenAI-compatible endpoint also works) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
LLM_THINKING=minimal

# --- Agora (console.agora.io) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# RESTful API credentials (Console > Developer Toolkit > RESTful API)
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# ASR block sent to Agora (JSON). Multi-language is also accepted, e.g. {"language": "en-IN,hi-IN"}
AGORA_ASR_JSON={"language": "hi-IN"}
# Secret Agora sends when calling our custom LLM endpoint (generate a random value)
AGORA_LLM_SHARED_SECRET=change-me
# Optional: override the Murf TTS block sent to Agora (default matches docs.agora.io/en/ai/models/tts/murf)
# AGORA_TTS_JSON={"vendor":"murf","params":{"api_key":"...","voiceId":"en-IN-anusha","locale":"en-IN","model":"FALCON","sample_rate":24000}}

# --- Murf Falcon ---
MURF_API_KEY=
# Bilingual female voice (Indian English + Hindi + Hinglish)
MURF_VOICE_ID=en-IN-anusha
MURF_LOCALE=en-IN
MURF_MODEL=FALCON

# Public HTTPS URL of this backend (e.g. an ngrok static domain) so Agora can reach the LLM endpoint
PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# devanagari | latin — default script for Hindi replies (per-turn language detection overrides this)
RESPONSE_SCRIPT=devanagari
