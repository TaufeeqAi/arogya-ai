# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible endpoint) ---
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1                              LLM_MODEL=gpt-4.1-mini
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ LLM_MODEL=gemini-2.5-flash
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1                          LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- Agora (console.agora.io) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# RESTful API credentials (Console > Developer Toolkit > RESTful API)
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# ASR block sent to Agora (JSON)
AGORA_ASR_JSON={"language": "hi-IN"}
# Optional: paste the exact Murf TTS block from Agora docs to override the default
# AGORA_TTS_JSON={"vendor":"murf","params":{"api_key":"...","voice_id":"hi-IN-shweta","model":"FALCON","locale":"hi-IN"}}

# --- Murf ---
MURF_API_KEY=
MURF_VOICE_ID=hi-IN-shweta
MURF_LOCALE=hi-IN

# Public HTTPS URL of this backend (ngrok) so Agora can call our LLM endpoint
PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# devanagari | latin  — script for Hindi replies sent to TTS
RESPONSE_SCRIPT=devanagari
