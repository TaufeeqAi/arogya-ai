{
  "additionalProperties": false,
  "properties": {
    "medication_id": {
      "title": "Medication Id",
      "type": "string"
    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "times_of_day": {
      "items": {
        "format": "time",
        "type": "string"
      },
      "minItems": 1,
      "title": "Times Of Day",
      "type": "array"
    },
    "days_of_week": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Days Of Week",
      "type": "array"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "end_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Date"
    },
    "source_document_id": {
      "title": "Source Document Id",
      "type": "string"
    },
    "source_verification_status": {
      "enum": [
        "UNVERIFIED",
        "PATIENT_ATTESTED",
        "PATIENT_CONFIRMED",
        "PROVIDER_AUTHENTICATED",
        "PROVIDER_VERIFIED",
        "REVIEW_REQUIRED",
        "REJECTED",
        "SOURCE_ONLY"
      ],
      "title": "Source Verification Status",
      "type": "string"
    },
    "patient_confirmation_required": {
      "default": true,
      "title": "Patient Confirmation Required",
      "type": "boolean"
    }
  },
  "required": [
    "medication_id",
    "timezone",
    "times_of_day",
    "start_date",
    "source_document_id",
    "source_verification_status"
